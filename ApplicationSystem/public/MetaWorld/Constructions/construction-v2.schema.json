{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodevision:construction:2",
  "title": "Nodevision construction definition, version 2 (not USD)",
  "type": "object",
  "required": [
    "schema",
    "version",
    "id",
    "voxelSize",
    "terrainVolumes"
  ],
  "properties": {
    "schema": {
      "const": "nodevision-construction"
    },
    "version": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/identity"
    },
    "name": {
      "type": "string"
    },
    "voxelSize": {
      "const": 0.25
    },
    "gridOrigin": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      }
    },
    "position": {
      "$ref": "#/$defs/gridVector"
    },
    "geometry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "\\.[gG][oO][xX]$",
              "description": "Notebook reference resolved relative to this definition; URLs and traversal outside Notebook are rejected."
            },
            "position": {
              "$ref": "#/$defs/gridVector"
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object"
    },
    "terrainVolumes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "shape",
          "position",
          "size",
          "operation",
          "active"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identity"
          },
          "position": {
            "$ref": "#/$defs/gridVector"
          },
          "size": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4000000
            }
          },
          "type": {
            "const": "TerrainCut"
          },
          "shape": {
            "const": "box"
          },
          "operation": {
            "const": "subtract"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "gridVector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": -4000000,
        "maximum": 4000000
      }
    }
  },
  "$comment": "Runtime additionally validates unique volume identities, bounded endpoints, grid alignment, references, and conflicts between instances.",
  "not": {
    "required": [
      "footprint"
    ]
  }
}
